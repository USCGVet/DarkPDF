# Normalize text files in the repo, check out with native endings.
* text=auto

# Binary assets: never translate bytes. sample.pdf contains raw uncompressed
# image streams, so CRLF conversion would corrupt its xref offsets.
*.pdf binary
*.png binary
*.jpg binary
*.ico binary

# Vendored PDF.js: keep bytes verbatim, keep it out of language stats/diffs.
libs/*.js -text -diff linguist-vendored

# Build artifact, regenerated by build.ps1 — collapse it in diffs.
dist/DarkPDF.html linguist-generated

# Keep PowerShell CRLF for Windows-native editing.
*.ps1 text eol=crlf
